# === Neon PostgreSQL ===
# Get a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# === Auth.js (NextAuth v5) ===
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# === Admin Seed ===
# Used by src/lib/db/seed.ts to create the initial admin account
ADMIN_SEED_EMAIL=admin@cse-portal.edu
ADMIN_SEED_PASSWORD=changeme123

# === Upload (optional — needed for question-paper file uploads in Phase 2) ===
# Get at https://uploadthing.com
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
